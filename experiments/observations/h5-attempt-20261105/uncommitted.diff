+// O3's output: one row per zone and hour of the grid (D23), from the cleaned trips, in two steps. The first gives
+// `hourly`, the zero-filled grid that both sides of the 4-week self-join read (D27). Pipeline.kt holds it between the
+// steps, so the grid's size, any join hint and the grid's cache (OPT-3, H5) stay visible there.
+
+// Step 1, on the cleaned trips: c(zone, hour) on every zone × hour of the grid, 0 for an hour without trips (D25).
+fun Dataset<Row>.zeroFilledHourlyCounts(grid: Dataset<Row>): Dataset<Row> = grid.withHourlyCounts(hourlyTripCounts())
+
+// Step 2, on `hourly` (step 1's result), which is read twice: by the bucket statistics (the current side) and by the
+// lag side of the self-join. No orderBy: it would add a sort and a shuffle for nothing.
+fun Dataset<Row>.demandForecast(zones: Dataset<Row>): Dataset<Row> = withBucketStats()
+    .withFourWeekLag(this)
+    .withDemandIndex()
+    .withServiceZone(zones)
+    .select(*outputColumns())
 
 // Fixes the column order and drops hour_index and the join's LocationID.
