+// `hourly` is the zero-filled grid (zones 1–263 × every hour of --years, D25), built in runPipeline so that its size
+// is visible there. Not partitioned.
+private fun writeDemandForecast(hourly: Dataset<Row>, zones: Dataset<Row>, args: PipelineArgs, profiler: Profiler) {
+    val out = args.outputOf(Operation.O3)
+    hourly.cachedForOpt3(args) {
+        profiler.profile("o3") { hourly.demandForecast(zones).write().mode(SaveMode.Overwrite).parquet(out.toString()) }
+    }
+    printForecastTotals(hourly.sparkSession(), out)
+}
+
+// OPT-3 (H5): both sides of O3's self-join read `hourly`. Cached, it's computed once, by the write that fills the
+// cache, and dropped right after that write. MEMORY_AND_DISK: a Dataset cache is already compressed columnar batches
+// (12–18 MB in all on 2025), and a partition that doesn't fit goes to disk instead of being recomputed.
+// --skip-opts opt3: no cache, so each side recomputes the zero-fill join (the baseline).
+private fun Dataset<Row>.cachedForOpt3(args: PipelineArgs, write: () -> Unit) {
+    if (!args.isApplied(Optimisation.OPT3)) return write()
+    persist(StorageLevel.MEMORY_AND_DISK())
+    try {
+        write()
+    } finally {
+        unpersist()
     }
-    printForecastTotals(cleaned.sparkSession(), out)
 }
 
