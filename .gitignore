.vscode/

# OS
.DS_Store
Thumbs.db

# Logs / local env
*.log
local.properties
.env

# Node (Git tooling only)
node_modules/

# Dataset (must never be committed)
data/
*.parquet

# Experiment raw output (event logs can be large; LOG.md and analysis CSVs are tracked)
experiments/runs/*/eventlog/

# Pipeline outputs and Spark local artefacts
output/
spark-warehouse/
metastore_db/
derby.log

# Other AI tools mirroring the .claude setup (Codex); .claude/ is the source of truth
.agents/
.codex/

# LaTeX build files (the report PDF itself is not ignored)
docs/report/*.aux
docs/report/*.bbl
docs/report/*.blg
docs/report/*.fdb_latexmk
docs/report/*.fls
docs/report/*.out
docs/report/*.synctex.gz
